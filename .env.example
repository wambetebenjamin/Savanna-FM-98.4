# Public live audio stream URL (Icecast, Shoutcast, MP3, or HLS if browser-compatible)
NEXT_PUBLIC_STREAM_URL=

# Optional server-side stream metadata JSON endpoint. If omitted, the API probes an Icecast status-json.xsl endpoint.
STREAM_URL=
STREAM_METADATA_URL=

# Optional Vercel KV integration (also used by the Vercel KV dashboard)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional WhatsApp Cloud API integration for /api/request
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_RECIPIENT=254112272061

# Optional newsroom feed URL returning an array of Savanna news objects
NEWS_FEED_URL=
